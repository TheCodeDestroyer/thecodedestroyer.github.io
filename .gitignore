# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# JetBrains
.idea

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ESLint
.eslintcache

# Env
*.env

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Beads: track only config.yaml, metadata.json; ignore db/runtime/connection env
.beads/*
!.beads/config.yaml
!.beads/metadata.json

# Agent rules auto-generated by `next dev` (Next 16). Disable with
# `agentRules: false` in next.config.ts if these are unwanted entirely.
/AGENTS.md
/CLAUDE.md

# Agent worktrees (git worktrees created under .claude by Claude Code)
/.claude/worktrees/
.env*
